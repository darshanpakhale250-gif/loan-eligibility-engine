# ─── Postgres (AWS RDS) ───
POSTGRES_HOST=your-rds-endpoint.ap-south-1.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_USER=loan_admin
POSTGRES_PASSWORD=CHANGE_ME_alphanumeric_password
POSTGRES_DB=loan_engine

# ─── n8n Security & Auth ───
N8N_ENCRYPTION_KEY=CHANGE_ME_alphanumeric_32_chars
N8N_DEFAULT_USER_EMAIL=admin@example.com
N8N_DEFAULT_USER_PASSWORD=CHANGE_ME_alphanumeric_password
WEBHOOK_SECRET=CHANGE_ME_alphanumeric_secret
INTERNAL_TOKEN=CHANGE_ME_alphanumeric_token
N8N_WEBHOOK_BASE_INTERNAL=http://n8n:5678/webhook

# ─── Storage & AWS S3 ───
STORAGE_MODE=s3
S3_BUCKET_NAME=loan-eligibility-uploads-your_account_id-dev
AWS_REGION=ap-south-1
PRESIGN_EXPIRATION_SECONDS=900

# ─── Backend / Crawler ───
MAX_PAGES=2
MAX_DEPTH=1
PAGE_TIMEOUT_MS=15000

# ─── Gemini (Optional) ───
GEMINI_API_KEY=
LLM_MAX_PAIRS=40

# ─── AWS SES (Email Notifications) ───
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=sender@example.com
TEST_EMAIL_BASE=recipient@example.com
TEST_VERIFIED_EMAILS=recipient1@example.com,recipient2@example.com
MAX_EMAILS_PER_RUN=3
EMAIL_DRY_RUN=true
