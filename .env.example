# ─── Postgres ───
POSTGRES_USER=loan_admin
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=loan_engine

# ─── n8n ───
N8N_ENCRYPTION_KEY=CHANGE_ME_random_32_chars
WEBHOOK_SECRET=CHANGE_ME_webhook_secret
INTERNAL_TOKEN=CHANGE_ME_internal_token
N8N_WEBHOOK_BASE_INTERNAL=http://n8n:5678/webhook

# ─── Backend / Crawler ───
STORAGE_MODE=local
MAX_PAGES=2
MAX_DEPTH=1
PAGE_TIMEOUT_MS=15000

# ─── Gemini (optional – matching works without it) ───
GEMINI_API_KEY=
LLM_MAX_PAIRS=40

# ─── AWS SES (email notifications) ───
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=you@example.com
TEST_EMAIL_BASE=you@gmail.com
MAX_EMAILS_PER_RUN=3
EMAIL_DRY_RUN=true
