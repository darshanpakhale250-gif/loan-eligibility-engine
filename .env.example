# ==============================================================================
# Loan Eligibility Engine - Environment Configuration Template
# Copy this file to .env and populate the actual secrets.
# NEVER commit .env to version control.
# ==============================================================================

# Database Configuration (PostgreSQL)
# Note: Inside Docker compose, n8n connects to host 'postgres'.
# Local python scripts running directly on the host should use 'localhost'.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=loan_engine
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password

# Database URL format for connection strings (e.g., psycopg2 / SQLAlchemy)
DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/loan_engine

# n8n Automation Engine
N8N_ENCRYPTION_KEY=replace_with_a_secure_random_key_min_32_chars
WEBHOOK_URL=http://localhost:5678/
N8N_PORT=5678
N8N_WEBHOOK_MATCHING_URL=http://localhost:5678/webhook/user-loan-matching

# AWS Configuration (Used for S3, SES, Lambda)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_BUCKET_NAME=loan-eligibility-engine-uploads

# AWS SES Configuration
# Warning: Never send emails to CSV addresses during testing. Use only verified test aliases.
SES_SENDER_EMAIL=verified_sender@example.com
SES_TEST_RECIPIENT_EMAIL=yourname+test@example.com

# LLM Configuration (Gemini API preferred for multi-stage matching)
GEMINI_API_KEY=your_gemini_api_key_here
